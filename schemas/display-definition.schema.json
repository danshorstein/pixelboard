{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoreboard.local/schemas/display-definition.schema.json",
  "title": "Scoreboard Display Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "targetLogical",
    "parameters",
    "scenes"
  ],
  "properties": {
    "schemaVersion": { "enum": ["1.0", "1.1", "1.2"] },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "targetLogical": { "$ref": "#/$defs/logical" },
    "parameters": { "$ref": "#/$defs/parameters" },
    "teamColors": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z0-9]{2,5}$" },
      "additionalProperties": { "$ref": "#/$defs/hexColor" }
    },
    "scenes": { "$ref": "#/$defs/sceneSet" },
    "overlays": {
      "type": "array",
      "items": { "$ref": "#/$defs/element" }
    },
    "presets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
      "additionalProperties": { "$ref": "#/$defs/sceneSet" }
    }
  },
  "$defs": {
    "logical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "height": { "type": "integer", "minimum": 1, "maximum": 4096 }
      }
    },
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "colorValue": {
      "type": "string",
      "pattern": "^(?:#[0-9A-Fa-f]{6}|\\$colors\\.[A-Za-z][A-Za-z0-9_]*)$"
    },
    "fontValue": {
      "type": "string",
      "pattern": "^(?:4x6|5x7|6x10|\\$fonts\\.[A-Za-z][A-Za-z0-9_]*)$"
    },
    "binding": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
    },
    "condition": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.]*\\s*(?:==|!=|<=|>=|<|>)\\s*(?:null|true|false|-?[0-9]+(?:\\.[0-9]+)?|\"[^\"]*\"|'[^']*')$"
    },
    "visibleWhen": {
      "type": "string",
      "pattern": "^\\$elements\\.[A-Za-z][A-Za-z0-9_]*$"
    },
    "position": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4095
    },
    "textSource": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "text": true, "bind": true },
          "required": ["text"],
          "not": {
            "type": "object",
            "properties": { "bind": true },
            "required": ["bind"]
          }
        },
        {
          "type": "object",
          "properties": { "text": true, "bind": true },
          "required": ["bind"],
          "not": {
            "type": "object",
            "properties": { "text": true },
            "required": ["text"]
          }
        }
      ]
    },
    "textElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "x", "y", "font", "color"],
      "properties": {
        "type": { "const": "text" },
        "x": { "$ref": "#/$defs/position" },
        "y": { "$ref": "#/$defs/position" },
        "font": { "$ref": "#/$defs/fontValue" },
        "color": { "$ref": "#/$defs/colorValue" },
        "text": { "type": "string", "maxLength": 200 },
        "bind": { "$ref": "#/$defs/binding" },
        "align": { "enum": ["left", "center", "right"] },
        "maxWidth": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "when": { "$ref": "#/$defs/condition" },
        "visibleWhen": { "$ref": "#/$defs/visibleWhen" }
      },
      "allOf": [{ "$ref": "#/$defs/textSource" }]
    },
    "boxElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "x", "y", "width", "height", "color"],
      "properties": {
        "type": { "const": "box" },
        "x": { "$ref": "#/$defs/position" },
        "y": { "$ref": "#/$defs/position" },
        "width": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "height": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "color": { "$ref": "#/$defs/colorValue" },
        "filled": { "type": "boolean", "default": false },
        "when": { "$ref": "#/$defs/condition" },
        "visibleWhen": { "$ref": "#/$defs/visibleWhen" }
      }
    },
    "lineElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "x1", "y1", "x2", "y2", "color"],
      "properties": {
        "type": { "const": "line" },
        "x1": { "$ref": "#/$defs/position" },
        "y1": { "$ref": "#/$defs/position" },
        "x2": { "$ref": "#/$defs/position" },
        "y2": { "$ref": "#/$defs/position" },
        "color": { "$ref": "#/$defs/colorValue" },
        "when": { "$ref": "#/$defs/condition" },
        "visibleWhen": { "$ref": "#/$defs/visibleWhen" }
      }
    },
    "spriteElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "x", "y", "mode"],
      "properties": {
        "type": { "const": "sprite" },
        "x": { "$ref": "#/$defs/position" },
        "y": { "$ref": "#/$defs/position" },
        "asset": {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "bind": { "$ref": "#/$defs/binding" },
        "mode": { "enum": ["1bit", "rgb"] },
        "color": { "$ref": "#/$defs/colorValue" },
        "when": { "$ref": "#/$defs/condition" },
        "visibleWhen": { "$ref": "#/$defs/visibleWhen" }
      },
      "oneOf": [
        {
          "properties": { "asset": true, "bind": true },
          "required": ["asset"],
          "not": { "properties": { "bind": true }, "required": ["bind"] }
        },
        {
          "properties": { "asset": true, "bind": true },
          "required": ["bind"],
          "not": { "properties": { "asset": true }, "required": ["asset"] }
        }
      ]
    },
    "basesDiamondElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "x", "y", "bind", "color", "occupiedColor"],
      "properties": {
        "type": { "const": "basesDiamond" },
        "x": { "$ref": "#/$defs/position" },
        "y": { "$ref": "#/$defs/position" },
        "bind": { "$ref": "#/$defs/binding" },
        "color": { "$ref": "#/$defs/colorValue" },
        "occupiedColor": { "$ref": "#/$defs/colorValue" },
        "size": { "type": "integer", "minimum": 2, "maximum": 12 },
        "when": { "$ref": "#/$defs/condition" },
        "visibleWhen": { "$ref": "#/$defs/visibleWhen" }
      }
    },
    "outsDotsElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "x", "y", "bind", "color", "activeColor"],
      "properties": {
        "type": { "const": "outsDots" },
        "x": { "$ref": "#/$defs/position" },
        "y": { "$ref": "#/$defs/position" },
        "bind": { "$ref": "#/$defs/binding" },
        "color": { "$ref": "#/$defs/colorValue" },
        "activeColor": { "$ref": "#/$defs/colorValue" },
        "spacing": { "type": "integer", "minimum": 2, "maximum": 20 },
        "when": { "$ref": "#/$defs/condition" },
        "visibleWhen": { "$ref": "#/$defs/visibleWhen" }
      }
    },
    "countTextElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "x", "y", "bind", "font", "color"],
      "properties": {
        "type": { "const": "countText" },
        "x": { "$ref": "#/$defs/position" },
        "y": { "$ref": "#/$defs/position" },
        "bind": { "$ref": "#/$defs/binding" },
        "font": { "$ref": "#/$defs/fontValue" },
        "color": { "$ref": "#/$defs/colorValue" },
        "prefix": { "type": "string", "maxLength": 20 },
        "when": { "$ref": "#/$defs/condition" },
        "visibleWhen": { "$ref": "#/$defs/visibleWhen" }
      }
    },
    "scrollTextElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "x", "y", "width", "font", "color", "speedPxPerSec"],
      "properties": {
        "type": { "const": "scrollText" },
        "x": { "$ref": "#/$defs/position" },
        "y": { "$ref": "#/$defs/position" },
        "width": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "font": { "$ref": "#/$defs/fontValue" },
        "color": { "$ref": "#/$defs/colorValue" },
        "speedPxPerSec": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "text": { "type": "string", "maxLength": 500 },
        "bind": { "$ref": "#/$defs/binding" },
        "when": { "$ref": "#/$defs/condition" },
        "visibleWhen": { "$ref": "#/$defs/visibleWhen" }
      },
      "allOf": [{ "$ref": "#/$defs/textSource" }]
    },
    "clockElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "x", "y", "font", "color", "format"],
      "properties": {
        "type": { "const": "clock" },
        "x": { "$ref": "#/$defs/position" },
        "y": { "$ref": "#/$defs/position" },
        "font": { "$ref": "#/$defs/fontValue" },
        "color": { "$ref": "#/$defs/colorValue" },
        "format": { "enum": ["12h", "24h"] },
        "when": { "$ref": "#/$defs/condition" },
        "visibleWhen": { "$ref": "#/$defs/visibleWhen" }
      }
    },
    "element": {
      "oneOf": [
        { "$ref": "#/$defs/textElement" },
        { "$ref": "#/$defs/boxElement" },
        { "$ref": "#/$defs/lineElement" },
        { "$ref": "#/$defs/spriteElement" },
        { "$ref": "#/$defs/basesDiamondElement" },
        { "$ref": "#/$defs/outsDotsElement" },
        { "$ref": "#/$defs/countTextElement" },
        { "$ref": "#/$defs/scrollTextElement" },
        { "$ref": "#/$defs/clockElement" }
      ]
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elements"],
      "properties": {
        "elements": {
          "type": "array",
          "items": { "$ref": "#/$defs/element" }
        }
      }
    },
    "sceneSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["live", "pregame", "final", "statusOnly", "idle"],
      "properties": {
        "live": { "$ref": "#/$defs/scene" },
        "pregame": { "$ref": "#/$defs/scene" },
        "final": { "$ref": "#/$defs/scene" },
        "statusOnly": { "$ref": "#/$defs/scene" },
        "idle": { "$ref": "#/$defs/scene" },
        "standings": { "$ref": "#/$defs/scene" }
      }
    },
    "choiceParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "default", "options"],
      "properties": {
        "type": { "const": "choice" },
        "default": { "type": "string", "minLength": 1 },
        "options": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "colorParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "default"],
      "properties": {
        "type": { "const": "color" },
        "default": { "$ref": "#/$defs/hexColor" }
      }
    },
    "toggleParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "default"],
      "properties": {
        "type": { "const": "toggle" },
        "default": { "type": "boolean" }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layoutPreset", "colors", "fonts", "elements", "transition"],
      "properties": {
        "layoutPreset": { "$ref": "#/$defs/choiceParameter" },
        "colors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "background",
            "scoreColor",
            "teamText",
            "statusText",
            "favoriteAccent",
            "useTeamColors"
          ],
          "properties": {
            "background": { "$ref": "#/$defs/colorParameter" },
            "scoreColor": { "$ref": "#/$defs/colorParameter" },
            "teamText": { "$ref": "#/$defs/colorParameter" },
            "statusText": { "$ref": "#/$defs/colorParameter" },
            "favoriteAccent": { "$ref": "#/$defs/colorParameter" },
            "useTeamColors": { "$ref": "#/$defs/toggleParameter" }
          }
        },
        "fonts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scoreFont", "labelFont"],
          "properties": {
            "scoreFont": { "$ref": "#/$defs/choiceParameter" },
            "labelFont": { "$ref": "#/$defs/choiceParameter" }
          }
        },
        "elements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "showBases",
            "showOuts",
            "showCount",
            "showProbables",
            "showClockWhenIdle"
          ],
          "properties": {
            "showBases": { "type": "boolean" },
            "showOuts": { "type": "boolean" },
            "showCount": { "type": "boolean" },
            "showProbables": { "type": "boolean" },
            "showClockWhenIdle": { "type": "boolean" }
          }
        },
        "transition": { "$ref": "#/$defs/choiceParameter" }
      }
    }
  }
}
