{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoreboard.local/schemas/asset-pack.schema.json",
  "title": "Private Team Asset Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "private", "assets"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$" },
    "private": { "const": true },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/teamLogo" }
    }
  },
  "$defs": {
    "teamLogo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "teamId",
        "abbr",
        "width",
        "height",
        "path",
        "sha256",
        "source",
        "usageStatus"
      ],
      "properties": {
        "teamId": { "type": ["integer", "string"] },
        "abbr": { "type": "string", "pattern": "^[A-Z0-9]{2,5}$" },
        "width": { "enum": [16, 20, 24] },
        "height": { "enum": [16, 20, 24] },
        "path": {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*\\.png$"
        },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "source": { "type": "string", "minLength": 1, "maxLength": 500 },
        "usageStatus": {
          "enum": ["private-personal-use", "licensed", "owner-provided", "review-required"]
        },
        "licenseNote": { "type": "string", "maxLength": 1000 }
      }
    }
  }
}
