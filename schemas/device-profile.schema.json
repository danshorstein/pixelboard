{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoreboard.local/schemas/device-profile.schema.json",
  "title": "Scoreboard Device Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "targetClass",
    "logical",
    "physical",
    "orientation",
    "capabilities",
    "validationRules"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "label": { "type": "string", "minLength": 1, "maxLength": 100 },
    "description": { "type": "string", "maxLength": 500 },
    "targetClass": {
      "type": "string",
      "pattern": "^[a-z0-9-]+@[0-9]+$"
    },
    "logical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 64, "maximum": 192 },
        "height": { "type": "integer", "minimum": 32, "maximum": 64 }
      }
    },
    "physical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widthMm", "heightMm", "pixelPitchMm"],
      "properties": {
        "widthMm": { "type": "number", "exclusiveMinimum": 0 },
        "heightMm": { "type": "number", "exclusiveMinimum": 0 },
        "pixelPitchMm": { "type": "number", "minimum": 2, "maximum": 10 }
      }
    },
    "orientation": { "enum": ["landscape", "portrait", "square"] },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color",
        "maxAnimationFps",
        "brightnessRange",
        "memoryBudgetMb"
      ],
      "properties": {
        "color": { "enum": ["rgb888"] },
        "maxAnimationFps": { "type": "integer", "minimum": 1, "maximum": 120 },
        "brightnessRange": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            { "type": "integer", "minimum": 0, "maximum": 100 },
            { "type": "integer", "minimum": 0, "maximum": 100 }
          ],
          "items": false
        },
        "memoryBudgetMb": { "type": "integer", "minimum": 16, "maximum": 4096 },
        "supportedElements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "text",
              "box",
              "line",
              "sprite",
              "basesDiamond",
              "outsDots",
              "countText",
              "scrollText",
              "clock"
            ]
          }
        }
      }
    },
    "validationRules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "resolution-match",
          "font-min-size",
          "asset-format",
          "memory-estimate",
          "effect-support",
          "network-assumption",
          "config-complete"
        ]
      }
    }
  }
}
