{
  "name": "pixelboard-scoreboard",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite --config frontend/vite.config.ts --open",
    "build": "tsc --noEmit && vite build --config frontend/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:py": ".venv/bin/python -m unittest discover -s tests_py -v",
    "dev:backend": ".venv/bin/uvicorn backend.app:app --host 127.0.0.1 --port 8124 --loop asyncio",
    "dev:sports": "node scripts/sports-preview.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10",
    "jsdom": "29.1.1"
  }
}
